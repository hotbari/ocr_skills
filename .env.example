# OpenAI API
OPENAI_API_KEY=sk-...

# 모델 설정
VISION_MODEL=gpt-4o
LLM_MODEL=gpt-4o-mini

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=ocr_pipeline

# 저장 경로
UPLOAD_DIR=./uploads
PIPELINE_STATE_DIR=./pipeline_state

# API 설정
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# 파일 제한
MAX_FILE_SIZE_MB=100
MAX_PAGES=500

# 파이프라인 옵션
ENABLE_VISION_CAPTIONING=true    # Stage 3: gpt-4o 이미지 캡셔닝
ENABLE_TAG_GENERATION=true       # Stage 4: LLM 태그/요약
USE_PADDLE_OCR=true              # 스캔 PDF PaddleOCR 사용
USE_PP_STRUCTURE=true            # PP-Structure 레이아웃 분석 사용
